# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (Base/system key seeded into the pool, from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Administrator Telegram User IDs (comma-separated list of integers)
# Administrators get access without needing to submit their own key.
# Regular users get access by submitting their Gemini API key via /key <your_key>.
# Example: ALLOWED_USERS=123456789,987654321
ALLOWED_USERS=123456789

# Gemini Models for transcription and summary
# Recommended defaults:
# - gemini-3.5-flash-lite (fast multimodal, generous quotas)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite

# Optional: SQLite Database path for the key pool (default: data/keys.db)
# DB_PATH=data/keys.db
