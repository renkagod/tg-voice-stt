# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Telegram User IDs (comma-separated list of integers)
# Only users in this list will be able to use the bot. Other users will be completely ignored.
# Example: ALLOWED_USERS=123456789,987654321
ALLOWED_USERS=123456789

# Gemini Model for transcription and summary
# Recommended defaults:
# - gemini-3.5-flash-lite (high rate limit: 500 RPD, fast multimodal)
# - gemini-3.5-transcribe (specialized ASR: 25 RPD, automatic fallback to flash-lite on quota limits)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite

